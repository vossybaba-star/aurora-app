# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Nylas (email sending) ────────────────────────────────────────────────────
# Found in: https://dashboard.nylas.com → Applications → API Keys
NYLAS_API_KEY=your_nylas_api_key
NYLAS_CLIENT_ID=your_nylas_client_id
NYLAS_API_URI=https://api.eu.nylas.com

# ─── App URL ──────────────────────────────────────────────────────────────────
# Must match the redirect URI registered in your Nylas dashboard
# Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google Places API (New) ──────────────────────────────────────────────────
# Found in: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API (New) — also enable Reviews if you want full_reviews populated
# Server-side only — no NEXT_PUBLIC prefix keeps the key off the client bundle
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Found in: https://console.anthropic.com → API Keys
# Used by: find-opportunities (AI lead ranking), generate-message (email drafting)
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Firecrawl ────────────────────────────────────────────────────────────────
# Found in: https://www.firecrawl.dev → Dashboard → API Keys
# Used by: lead enrichment pipeline (website scraping), profile import-from-website
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key
